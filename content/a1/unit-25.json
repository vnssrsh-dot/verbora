  "rule": {
    "formula": {
      "ua": "дієслово + -ed · didn't + дієслово · Did … + дієслово?",
      "ru": "глагол + -ed · didn't + глагол · Did … + глагол?"
    },
    "explain": {
      "ua": "Past Simple — завершена дія в минулому (yesterday, last week, ago). Правильні дієслова отримують -ed — однаково для всіх: I worked, she worked. Для заперечень і питань — did / didn't.",
      "ru": "Past Simple — законченное действие в прошлом (yesterday, last week, ago). Правильные глаголы получают -ed — одинаково для всех: I worked, she worked. Для отрицаний и вопросов — did / didn't."
    },
    "examples": [
      {
        "en": "I worked yesterday.",
        "ua": "Учора я працював.",
        "ru": "Вчера я работал."
      },
      {
        "en": "She didn't call me.",
        "ua": "Вона мені не подзвонила.",
        "ru": "Она мне не позвонила."
      },
      {
        "en": "Did you watch the film?",
        "ua": "Ти дивився фільм?",
        "ru": "Ты смотрел фильм?"
      }
    ],
    "compare": {
      "ua": "В українській минулий час має рід (працював, працювала). В англійській форма одна для всіх: worked.",
      "ru": "В русском прошедшее время имеет род (работал, работала). В английском форма одна для всех: worked."
    }
  },
