  "title": {
    "en": "There is / there are",
    "ua": "There is / there are",
    "ru": "There is / there are"
  },
  "rule": {
    "formula": {
      "ua": "There is + один · There are + багато",
      "ru": "There is + один · There are + много"
    },
    "explain": {
      "ua": "There is / there are — «є, знаходиться». Так кажемо, що щось десь є: There is a café near my house.",
      "ru": "There is / there are — «есть, находится». Так говорим, что что-то где-то есть: There is a café near my house."
    },
    "examples": [
      {
        "en": "There is a park near my house.",
        "ua": "Біля мого будинку є парк.",
        "ru": "Возле моего дома есть парк."
      },
      {
        "en": "There are two beds in the room.",
        "ua": "У кімнаті два ліжка.",
        "ru": "В комнате две кровати."
      },
      {
        "en": "Is there a bank here?",
        "ua": "Тут є банк?",
        "ru": "Здесь есть банк?"
      }
    ],
    "compare": {
      "ua": "Українською кажемо з кінця: «У кімнаті є стіл». Англійською починаємо з there is: There is a table in the room.",
      "ru": "По-русски говорим с конца: «В комнате есть стол». По-английски начинаем с there is: There is a table in the room."
    }
  },
