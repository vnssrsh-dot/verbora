  "title": {
    "en": "Have got / has got",
    "ua": "Have got / has got",
    "ru": "Have got / has got"
  },
  "rule": {
    "formula": "I / you / we / they have got · he / she / it has got",
    "explain": {
      "ua": "Have got — «у мене є». Has got — для he, she, it. Скорочено: I've got, she's got. Це британський варіант, у розмові дуже частий.",
      "ru": "Have got — «у меня есть». Has got — для he, she, it. Сокращённо: I've got, she's got. Это британский вариант, в разговоре очень частый."
    },
    "examples": [
      {
        "en": "I've got a dog.",
        "ua": "У мене є собака.",
        "ru": "У меня есть собака."
      },
      {
        "en": "She has got two sisters.",
        "ua": "У неї дві сестри.",
        "ru": "У неё две сестры."
      },
      {
        "en": "Have you got a car?",
        "ua": "У тебе є машина?",
        "ru": "У тебя есть машина?"
      }
    ],
    "compare": {
      "ua": "Українською «у мене є», а англійською — «я маю»: I have got. Хто має — стоїть першим.",
      "ru": "По-русски «у меня есть», а по-английски — «я имею»: I have got. Кто имеет — стоит первым."
    }
  },
