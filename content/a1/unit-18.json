  "rule": {
    "formula": "always 100% · usually · often · sometimes · never 0% · at 7 · on Monday · in the morning",
    "explain": {
      "ua": "Слова частотності кажуть, як часто ми щось робимо. Стоять перед дієсловом (I always get up at 7), але після am / is / are (She is never late).",
      "ru": "Слова частотности говорят, как часто мы что-то делаем. Стоят перед глаголом (I always get up at 7), но после am / is / are (She is never late)."
    },
    "examples": [
      {
        "en": "I always drink coffee.",
        "ua": "Я завжди п'ю каву.",
        "ru": "Я всегда пью кофе."
      },
      {
        "en": "She is never late.",
        "ua": "Вона ніколи не запізнюється.",
        "ru": "Она никогда не опаздывает."
      },
      {
        "en": "We go to the cinema on Fridays.",
        "ua": "Ми ходимо в кіно по п'ятницях.",
        "ru": "Мы ходим в кино по пятницам."
      }
    ],
    "compare": {
      "ua": "Never вже означає «ніколи не» — друге заперечення не потрібне: I never smoke (не I don't never smoke).",
      "ru": "Never уже значит «никогда не» — второе отрицание не нужно: I never smoke (не I don't never smoke)."
    }
  },
