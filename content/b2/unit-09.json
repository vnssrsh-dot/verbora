  },
  "rule": {
    "formula": {
      "ua": "be (у потрібному часі) + V3 · is being done · has been done · will be done · can be done",
      "ru": "be (в нужном времени) + V3 · is being done · has been done · will be done · can be done"
    },
    "explain": {
      "ua": "Пасив можливий майже в усіх часах — змінюється тільки be: The road is being repaired. My bag has been stolen. It will be finished tomorrow. It must be done today.",
      "ru": "Пассив возможен почти во всех временах — меняется только be: The road is being repaired. My bag has been stolen. It will be finished tomorrow. It must be done today."
    },
    "examples": [
      {
        "en": "The house is being painted.",
        "ua": "Будинок зараз фарбують.",
        "ru": "Дом сейчас красят."
      },
      {
        "en": "My car has been fixed.",
        "ua": "Мою машину полагодили.",
        "ru": "Мою машину починили."
      },
      {
        "en": "The results will be announced tomorrow.",
        "ua": "Результати оголосять завтра.",
        "ru": "Результаты объявят завтра."
      }
    ]
  },
