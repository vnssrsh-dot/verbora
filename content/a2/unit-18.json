  "rule": {
    "formula": {
      "ua": "прикметник + -ly = прислівник (як?): quick → quickly",
      "ru": "прилагательное + -ly = наречие (как?): quick → quickly"
    },
    "explain": {
      "ua": "Прикметник описує іменник (a slow car). Прислівник описує дію — як? (He drives slowly). Зазвичай + -ly. Є винятки: good → well, fast → fast, hard → hard.",
      "ru": "Прилагательное описывает существительное (a slow car). Наречие описывает действие — как? (He drives slowly). Обычно + -ly. Есть исключения: good → well, fast → fast, hard → hard."
    },
    "examples": [
      {
        "en": "She speaks quietly.",
        "ua": "Вона говорить тихо.",
        "ru": "Она говорит тихо."
      },
      {
        "en": "He is a good cook. He cooks well.",
        "ua": "Він добрий кухар. Він добре готує.",
        "ru": "Он хороший повар. Он хорошо готовит."
      },
      {
        "en": "Drive carefully!",
        "ua": "Їдь обережно!",
        "ru": "Езжай осторожно!"
      }
    ]
  },
