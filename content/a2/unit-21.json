  "rule": {
    "formula": {
      "ua": "питальне слово + допоміжне + хто + дієслово? · Who called? (питання до підмета — без do)",
      "ru": "вопросительное слово + вспомогательный + кто + глагол? · Who called? (вопрос к подлежащему — без do)"
    },
    "explain": {
      "ua": "Звичайне питання: Where do you live? Але якщо питаємо, ХТО зробив (Who / What — підмет), допоміжного немає: Who lives here? What happened?",
      "ru": "Обычный вопрос: Where do you live? Но если спрашиваем, КТО сделал (Who / What — подлежащее), вспомогательного нет: Who lives here? What happened?"
    },
    "examples": [
      {
        "en": "Who called you?",
        "ua": "Хто тобі дзвонив?",
        "ru": "Кто тебе звонил?"
      },
      {
        "en": "Who did you call?",
        "ua": "Кому ти дзвонив?",
        "ru": "Кому ты звонил?"
      },
      {
        "en": "How often do you go there?",
        "ua": "Як часто ти туди ходиш?",
        "ru": "Как часто ты туда ходишь?"
      }
    ]
  },
