      "rule": {
        "formula": {
          "ua": "Who / What + дієслово? — без do / does / did",
          "ru": "Who / What + глагол? — без do / does / did"
        },
        "explain": {
          "ua": "Коли Who / What — це той, хто діє, порядок як у ствердженні: Who lives here? (Max lives here.) What happened? Якщо Who — той, на кого дія, потрібен do: Who did you see?",
          "ru": "Когда Who / What — это тот, кто действует, порядок как в утверждении: Who lives here? (Max lives here.) What happened? Если Who — тот, на кого действие, нужен do: Who did you see?"
        },
        "examples": [
          {
            "en": "Who wants coffee?",
            "ua": "Хто хоче кави?",
            "ru": "Кто хочет кофе?"
          },
          {
            "en": "What happened?",
            "ua": "Що сталося?",
            "ru": "Что случилось?"
          },
          {
            "en": "Who did you meet?",
            "ua": "Кого ти зустрів?",
            "ru": "Кого ты встретил?"
          }
        ]
      },
      "exercises": [
        {
          "type": "choose",
          "topic": "subject-questions",
          "question": "Who ___ here? — Max lives here.",
          "options": [
            "lives",
            "does live",
            "do live"
