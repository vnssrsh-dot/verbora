  "title": {
    "en": "Past Continuous",
    "ua": "Past Continuous",
    "ru": "Past Continuous"
  },
  "rule": {
    "formula": {
      "ua": "was / were + дієслово-ing",
      "ru": "was / were + глагол-ing"
    },
    "explain": {
      "ua": "Past Continuous — дія, яка тривала в певний момент минулого: At 8 pm I was cooking. Часто — фон для іншої, короткої дії: I was cooking when the phone rang.",
      "ru": "Past Continuous — действие, которое длилось в определённый момент прошлого: At 8 pm I was cooking. Часто — фон для другого, короткого действия: I was cooking when the phone rang."
    },
    "examples": [
      {
        "en": "At 7 I was having dinner.",
        "ua": "О сьомій я вечеряв.",
        "ru": "В семь я ужинал."
      },
      {
        "en": "They were sleeping.",
        "ua": "Вони спали (у той момент).",
        "ru": "Они спали (в тот момент)."
      },
      {
        "en": "I was walking when it started to rain.",
        "ua": "Я гуляв, коли почався дощ.",
        "ru": "Я гулял, когда начался дождь."
      }
    ],
    "compare": {
      "ua": "Це «минулий Continuous»: як I'm cooking, тільки am / is / are → was / were.",
      "ru": "Это «прошедший Continuous»: как I'm cooking, только am / is / are → was / were."
    }
  },
