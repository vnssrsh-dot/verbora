  "rule": {
    "formula": {
      "ua": "will ('ll) + дієслово · won't · Will you…?",
      "ru": "will ('ll) + глагол · won't · Will you…?"
    },
    "explain": {
      "ua": "Will — рішення в момент розмови (I'll take it!), обіцянки й пропозиції (I'll help you), прогнози-думки (I think it will rain). Однаково для всіх, без -s.",
      "ru": "Will — решение в момент разговора (I'll take it!), обещания и предложения (I'll help you), прогнозы-мнения (I think it will rain). Одинаково для всех, без -s."
    },
    "examples": [
      {
        "en": "I'll call you later.",
        "ua": "Я тобі пізніше подзвоню.",
        "ru": "Я тебе позже позвоню."
      },
      {
        "en": "It won't take long.",
        "ua": "Це ненадовго.",
        "ru": "Это ненадолго."
      },
      {
        "en": "Will you help me?",
        "ua": "Допоможеш мені?",
        "ru": "Поможешь мне?"
      }
    ],
    "compare": {
      "ua": "Will — це «буду, -му»: I will work = я працюватиму. Але для вже вирішених планів краще going to.",
      "ru": "Will — это «буду»: I will work = я буду работать. Но для уже решённых планов лучше going to."
    }
  },
