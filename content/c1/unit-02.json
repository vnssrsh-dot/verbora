  "rule": {
    "formula": {
      "ua": "It was X that… · What I need is… · All I want is… · do / did + дієслово",
      "ru": "It was X that… · What I need is… · All I want is… · do / did + глагол"
    },
    "explain": {
      "ua": "Щоб виділити головне, розбиваємо речення на дві частини: Tom broke the vase → It was Tom who broke the vase. I need a holiday → What I need is a holiday. А do / did перед дієсловом додає «справді»: I did call you!",
      "ru": "Чтобы выделить главное, разбиваем предложение на две части: Tom broke the vase → It was Tom who broke the vase. I need a holiday → What I need is a holiday. А do / did перед глаголом добавляет «действительно»: I did call you!"
    },
    "examples": [
      {
        "en": "It was my grandma who taught me to cook.",
        "ua": "Саме бабуся навчила мене готувати.",
        "ru": "Именно бабушка научила меня готовить."
      },
      {
        "en": "What I love about Lviv is the coffee.",
        "ua": "Що я люблю у Львові — так це каву.",
        "ru": "Что я люблю во Львове — так это кофе."
      },
      {
        "en": "I do understand you.",
        "ua": "Я справді тебе розумію.",
        "ru": "Я правда тебя понимаю."
      }
    ]
  },
