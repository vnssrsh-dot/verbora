      "rule": {
        "formula": {
          "ua": "It is / was + виділене + that / who + решта речення",
          "ru": "It is / was + выделенное + that / who + остальное предложение"
        },
        "explain": {
          "ua": "Виділяти можна будь-що: людину (It was Anna who called), місце (It was in Kyiv that…), час (It was yesterday that…), причину (It was because of you that…). Для людей можна who, для іншого — that.",
          "ru": "Выделять можно что угодно: человека (It was Anna who called), место (It was in Kyiv that…), время (It was yesterday that…), причину (It was because of you that…). Для людей можно who, для остального — that."
        },
        "examples": [
          {
            "en": "It was Max who told me the news.",
            "ua": "Саме Макс розповів мені новину.",
            "ru": "Именно Макс рассказал мне новость."
          },
          {
            "en": "It was in 2015 that we moved to Warsaw.",
            "ua": "Саме 2015 року ми переїхали до Варшави.",
            "ru": "Именно в 2015 году мы переехали в Варшаву."
