  "rule": {
    "formula": {
      "ua": "поступка: even though, much as, nevertheless, nonetheless · причина: due to, owing to, as a result of · наслідок: consequently, therefore, hence, thus",
      "ru": "уступка: even though, much as, nevertheless, nonetheless · причина: due to, owing to, as a result of · следствие: consequently, therefore, hence, thus"
    },
    "explain": {
      "ua": "На C1 замість простих but / because / so вживають точніші зв'язки. Важливо, що йде після них: due to + іменник, because + речення; nevertheless / therefore — після крапки або крапки з комою.",
      "ru": "На C1 вместо простых but / because / so используют более точные связки. Важно, что идёт после них: due to + существительное, because + предложение; nevertheless / therefore — после точки или точки с запятой."
    },
    "examples": [
      {
        "en": "Much as I love him, I can't live with him.",
        "ua": "Хоч як я його люблю, я не можу з ним жити.",
        "ru": "Как бы я его ни любила, я не могу с ним жить."
      },
      {
        "en": "The flight was delayed due to fog.",
        "ua": "Рейс затримали через туман.",
        "ru": "Рейс задержали из-за тумана."
      },
      {
        "en": "Sales fell. Consequently, staff were cut.",
        "ua": "Продажі впали. Як наслідок, скоротили персонал.",
        "ru": "Продажи упали. Как следствие, сократили персонал."
      }
    ]
  },
