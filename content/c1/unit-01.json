  "rule": {
    "formula": {
      "ua": "Never / Rarely / Not only / No sooner … + допоміжне + підмет + дієслово",
      "ru": "Never / Rarely / Not only / No sooner … + вспомогательный + подлежащее + глагол"
    },
    "explain": {
      "ua": "Інверсія — це порядок слів як у питанні, але в ствердженні. Звучить сильно й офіційно: I have never seen… → Never have I seen… Вживається в промовах, статтях, есе і для драматичного ефекту.",
      "ru": "Инверсия — это порядок слов как в вопросе, но в утверждении. Звучит сильно и официально: I have never seen… → Never have I seen… Используется в речах, статьях, эссе и для драматического эффекта."
    },
    "examples": [
      {
        "en": "Never have I seen such a beautiful sunset.",
        "ua": "Ніколи я не бачила такого гарного заходу сонця.",
        "ru": "Никогда я не видела такого красивого заката."
      },
      {
        "en": "Not only is she smart, but she's also kind.",
        "ua": "Вона не лише розумна, а й добра.",
        "ru": "Она не только умная, но и добрая."
      },
      {
        "en": "Had I known, I would have called.",
        "ua": "Якби я знала, я б подзвонила.",
        "ru": "Если бы я знала, я бы позвонила."
      }
    ],
    "compare": {
      "ua": [
        "I have never seen…",
        "Never have I seen…"
      ],
      "ru": [
        "If I had known…",
        "Had I known…"
      ]
    }
  },
