          {
            "en": "Prices are likely to go up next year.",
            "ua": "Ціни, ймовірно, зростуть наступного року.",
            "ru": "Цены, вероятно, вырастут в следующем году."
          },
          {
            "en": "There's nothing on TV — we might as well go to bed.",
            "ua": "По телевізору нічого — можна й спати лягати.",
            "ru": "По телевизору ничего — можно и спать ложиться."
          }
        ]
