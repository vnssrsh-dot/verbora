  "title": {
    "en": "Present Perfect or Past Simple",
    "ua": "Present Perfect чи Past Simple",
    "ru": "Present Perfect или Past Simple"
  },
  "rule": {
    "formula": {
      "ua": "коли — неважливо / зв'язок із зараз → Present Perfect · конкретний час у минулому → Past Simple",
      "ru": "когда — неважно / связь с сейчас → Present Perfect · конкретное время в прошлом → Past Simple"
    },
    "explain": {
      "ua": "Present Perfect — досвід, результат зараз, період, що ще триває (today, this week, ever, for, since). Past Simple — закінчений момент у минулому (yesterday, in 2019, last week, ago, when…?).",
      "ru": "Present Perfect — опыт, результат сейчас, период, который ещё длится (today, this week, ever, for, since). Past Simple — законченный момент в прошлом (yesterday, in 2019, last week, ago, when…?)."
    },
    "examples": [
      {
        "en": "I've been to Italy. I went there in 2019.",
        "ua": "Я бував в Італії. Я їздив туди у 2019-му.",
        "ru": "Я был в Италии. Я ездил туда в 2019-м."
      },
      {
        "en": "She has lost her keys.",
        "ua": "Вона загубила ключі (і їх досі немає).",
        "ru": "Она потеряла ключи (и их до сих пор нет)."
      },
      {
        "en": "I've lived here for five years.",
        "ua": "Я живу тут уже п'ять років.",
        "ru": "Я живу здесь уже пять лет."
      }
    ],
    "compare": {
      "ua": "Найчастіша помилка: «I have seen him yesterday». Є слово yesterday — тільки Past Simple: I saw him yesterday.",
      "ru": "Самая частая ошибка: «I have seen him yesterday». Есть слово yesterday — только Past Simple: I saw him yesterday."
    }
  },
