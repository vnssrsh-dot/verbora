  "rule": {
    "formula": {
      "ua": "He said (that)… — час «зсувається» на крок у минуле: is → was, will → would, can → could",
      "ru": "He said (that)… — время «сдвигается» на шаг в прошлое: is → was, will → would, can → could"
    },
    "explain": {
      "ua": "Переказуємо чужі слова: «I'm tired» → She said (that) she was tired. Займенники теж змінюються: I → she, my → her.",
      "ru": "Пересказываем чужие слова: «I'm tired» → She said (that) she was tired. Местоимения тоже меняются: I → she, my → her."
    },
    "examples": [
      {
        "en": "'I'm busy.' → He said he was busy.",
        "ua": "«Я зайнятий» → Він сказав, що зайнятий.",
        "ru": "«Я занят» → Он сказал, что занят."
      },
      {
        "en": "'I'll call you.' → She said she would call me.",
        "ua": "«Я тобі подзвоню» → Вона сказала, що подзвонить.",
        "ru": "«Я тебе позвоню» → Она сказала, что позвонит."
      },
      {
        "en": "'I can swim.' → He told me he could swim.",
        "ua": "«Я вмію плавати» → Він сказав, що вміє плавати.",
        "ru": "«Я умею плавать» → Он сказал, что умеет плавать."
      }
    ],
    "compare": {
      "ua": "В українській час не змінюється: «сказав, що втомлений». В англійській після said — крок назад: said he was tired.",
      "ru": "В русском время не меняется: «сказал, что устал». В английском после said — шаг назад: said he was tired."
    }
  },
