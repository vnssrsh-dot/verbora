  "rule": {
    "formula": {
      "ua": "If + Past Simple, would + дієслово — уявна / малоймовірна ситуація",
      "ru": "If + Past Simple, would + глагол — воображаемая / маловероятная ситуация"
    },
    "explain": {
      "ua": "Second conditional — мрії, уява, нереальне зараз: If I had a lot of money, I would travel the world (але грошей немає). Минулий час тут не про минуле!",
      "ru": "Second conditional — мечты, воображение, нереальное сейчас: If I had a lot of money, I would travel the world (но денег нет). Прошедшее время здесь не о прошлом!"
    },
    "examples": [
      {
        "en": "If I had more time, I would learn Italian.",
        "ua": "Якби в мене було більше часу, я б вивчала італійську.",
        "ru": "Если бы у меня было больше времени, я бы учила итальянский."
      },
      {
        "en": "If I were you, I'd call her.",
        "ua": "На твоєму місці я б їй подзвонив.",
        "ru": "На твоём месте я бы ей позвонил."
      },
      {
        "en": "What would you do if you won the lottery?",
        "ua": "Що б ти зробив, якби виграв у лотерею?",
        "ru": "Что бы ты сделал, если бы выиграл в лотерею?"
      }
    ],
    "compare": {
      "ua": "Це українське «якби… -б». If I knew = якби я знав. I would tell = я б сказав.",
      "ru": "Это русское «если бы… бы». If I knew = если бы я знал. I would tell = я бы сказал."
    }
  },
