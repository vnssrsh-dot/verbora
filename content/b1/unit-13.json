            "en": "We stopped to buy some water.",
            "ua": "Ми зупинилися, щоб купити води.",
            "ru": "Мы остановились, чтобы купить воды."
          },
          {
            "en": "Remember to lock the door!",
            "ua": "Не забудь замкнути двері!",
            "ru": "Не забудь закрыть дверь!"
          }
        ]
      },
