  "title": {
    "en": "Present Perfect Continuous",
    "ua": "Present Perfect Continuous",
    "ru": "Present Perfect Continuous"
  },
  "rule": {
    "formula": "have / has been + -ing",
    "explain": {
      "ua": "Present Perfect Continuous — дія почалася в минулому, триває досі (або щойно закінчилася) і важлива її тривалість: I've been waiting for an hour!",
      "ru": "Present Perfect Continuous — действие началось в прошлом, длится до сих пор (или только что закончилось) и важна его длительность: I've been waiting for an hour!"
    },
    "examples": [
      {
        "en": "I've been learning English for two years.",
        "ua": "Я вивчаю англійську два роки.",
        "ru": "Я учу английский два года."
      },
      {
        "en": "It's been raining all day.",
        "ua": "Дощ іде весь день.",
        "ru": "Дождь идёт весь день."
      },
      {
        "en": "You're wet! Have you been swimming?",
        "ua": "Ти мокрий! Ти плавав?",
        "ru": "Ты мокрый! Ты плавал?"
      }
    ]
  },
