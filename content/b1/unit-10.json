  "rule": {
    "formula": {
      "ua": "must — точно так · may / might / could — можливо · can't — точно ні",
      "ru": "must — точно так · may / might / could — возможно · can't — точно нет"
    },
    "explain": {
      "ua": "Робимо висновки й здогадки про теперішнє: He must be tired (точно — він працював 12 годин). She might be at home (можливо). It can't be true (не може бути!).",
      "ru": "Делаем выводы и догадки о настоящем: He must be tired (точно — он работал 12 часов). She might be at home (возможно). It can't be true (не может быть!)."
    },
    "examples": [
      {
        "en": "You must be hungry.",
        "ua": "Ти, мабуть, голодний.",
        "ru": "Ты, наверное, голоден."
      },
      {
        "en": "He may be late.",
        "ua": "Він, можливо, запізниться.",
        "ru": "Он, возможно, опоздает."
      },
      {
        "en": "That can't be Anna. She's in Paris.",
        "ua": "Це не може бути Анна. Вона в Парижі.",
        "ru": "Это не может быть Анна. Она в Париже."
      }
    ],
    "compare": {
      "ua": "Тут must — не «мусить», а «напевно, точно». Протилежність must у здогадках — can't, а не mustn't!",
      "ru": "Здесь must — не «должен», а «наверняка, точно». Противоположность must в догадках — can't, а не mustn't!"
    }
  },
